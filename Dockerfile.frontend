# ── Frontend – Development ──────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install dependencies first (layer cache)
COPY package*.json ./
RUN npm ci

# Copy source
COPY . .

EXPOSE 5173

# --host exposes the Vite dev server to all interfaces inside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
